parameters:
    level: max
    phpVersion: 80200
    paths:
        - src
        - autoload.php
        - uninstall.php
        - vibestatic-addon-boilerplate.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    # The core plugin is a runtime dependency, not a Composer one: it is
    # installed alongside, not required. Its classes are therefore invisible to
    # static analysis here, and referencing them is not an error.
    #
    # Upstream solved this by committing a 5169-line copy of wp-cli-stubs-2.2.0
    # into every add-on repository - twelve copies of a file nobody could
    # update. The stubs come from Composer now, and only the core's own surface
    # is declared below.
    ignoreErrors:
        -
            identifier: class.notFound
            message: '#WP2Static\\#'
        -
            identifier: staticMethod.notFound
            message: '#WP2Static\\#'
        # A settings form is read from $_POST; that is the mechanism WordPress
        # gives, not a shortcut around one. thecodingmachine's rule is about
        # business logic reaching into superglobals, and the answer to it here
        # is Options::savePosted() - one place, which reads only the names the
        # add-on declared and sanitises each on the expression that reads it.
        # Confined to that method so the rule still applies everywhere else.
        -
            identifier: thecodingmachine.superglobalUsed
            path: src/Options.php
    treatPhpDocTypesAsCertain: false

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/thecodingmachine/phpstan-strict-rules/phpstan-strict-rules.neon
