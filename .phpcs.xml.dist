<?xml version="1.0"?>
<ruleset name="VibeStatic add-ons">
  <description>Coding standard for every VibeStatic add-on in this repository. Same rules as the core.</description>

  <file>addons</file>
  <file>tests</file>
  <file>verify.php</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <arg name="colors"/>
  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>
  <arg value="s"/>
  <arg name="tab-width" value="4"/>

  <config name="minimum_wp_version" value="6.5"/>

  <rule ref="WordPress">
    <!-- PSR-4, camelCase and namespaced classes are a deliberate choice here. -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
    <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    <exclude name="Generic.Formatting.MultipleStatementAlignment.NotSameWarning"/>
    <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie.BraceOnNewLine"/>
    <exclude name="Squiz.Commenting.ClassComment.Missing"/>

    <!--
      A method implementing an abstract that is documented on the abstract does
      not need the contract restated under it: `slug()`, `label()`, `put()` and
      the rest are described once, in WP2Static\Addon\Controller and in the deployer base,
      which is the only place a reader looking for the contract will go. What is
      still enforced is @param and @return wherever a docblock exists at all.
    -->
    <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
    <exclude name="Squiz.Commenting.FileComment.Missing"/>
    <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
    <exclude name="Squiz.Commenting.PostStatementComment.Found"/>
    <exclude name="Squiz.Commenting.VariableComment.Missing"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterEnd"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd"/>
    <exclude name="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.MemberNotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCaseMemberVar"/>
    <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

    <!--
      Same set the core excludes, and for the same reasons: four-space indents
      (which .editorconfig also says), `: void` with a space before the colon,
      and the direct-query sniffs — an add-on's options table is not something
      the WordPress options API can hold, and there is no object cache in front
      of a table read once per admin page.
    -->
    <exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="PSR12.Functions.ReturnTypeDeclaration.SpaceBeforeColon"/>
    <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    <exclude name="Squiz.Commenting.FunctionComment.ThrowsNoFullStop"/>
    <exclude name="Squiz.Commenting.LongConditionClosingComment.SpacingBefore"/>
    <exclude name="Squiz.PHP.DisallowMultipleAssignments.Found"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
  </rule>

  <!--
    One text domain across the plugin and every add-on, deliberately: they ship
    against the same core and three .pot files to translate one product is two
    of them falling behind.
  -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="vibestatic"/>
      </property>
    </properties>
  </rule>

  <!--
    WP_Filesystem and wp_remote_get are the right answers to different
    questions. These add-ons read and write files the plugin itself has just
    generated, at paths the plugin chose, on the machine the code is running on:
    WP_Filesystem exists to route writes through FTP on installs where PHP
    cannot write, and its API cannot stream, which matters when the file being
    sent is a video. wp_remote_get fetches over HTTP, which is not what
    file_get_contents is doing here. parse_url is used on URLs this code
    produced, not on user input.

    The core makes the same call in SimpleRewriter and FileWriter.
  -->
  <rule ref="WordPress.WP.AlternativeFunctions">
    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fopen"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fclose"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.parse_url_parse_url"/>
  </rule>

  <!--
    The test doubles. A test that stands in for wpdb has to assign to
    $GLOBALS['wpdb'], and one that builds a processed site to deploy has to
    create and delete real directories: these sniffs describe how plugin code
    should behave at runtime, and a test double is neither.
  -->
  <rule ref="WordPress.WP.GlobalVariablesOverride">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP.AlternativeFunctions">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.PHP.NoSilencedErrors">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>

  <!--
    The test harness: stubs.php, functions.php, phpstan/guzzle.php, verify.php.

    A stub file exists to declare several classes, in several namespaces, in one
    place — that is what makes it a stub rather than a copy of a library. The
    WordPress standard forbids exactly that, rightly, about plugin code: one
    class per file, no curly-brace namespaces, indented its way. These four are
    not plugin code, and the shipped add-ons pass the full standard with nothing
    excluded.
  -->
  <rule ref="Universal.Namespaces.DisallowCurlyBraceSyntax">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>
  <rule ref="Universal.Files.SeparateFunctionsFromOO">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>
  <rule ref="Squiz.Classes.ClassFileName">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>
  <rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>
  <rule ref="Squiz.WhiteSpace.ScopeClosingBrace">
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>

  <!--
    verify.php prints to a terminal, not to a page.

    WordPress.Security.EscapeOutput exists because unescaped output in an admin
    page is how a stored value becomes markup in somebody's browser. This script
    is run from the command line, its output is read by whoever typed the
    command, and esc_html() on a progress line would put &amp;#039; in a message
    about an add-on. It was never linted before, because it lived outside every
    add-on's ruleset.
  -->
  <rule ref="WordPress.Security.EscapeOutput">
    <exclude-pattern>verify.php</exclude-pattern>
  </rule>

  <rule ref="WordPress.WP.CapitalPDangit">
    <exclude-pattern>*</exclude-pattern>
  </rule>
</ruleset>
